{
  "version": 1,
  "hooks": {
    "afterAgentResponse": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/unslop-hook.py\" capture"
      }
    ],
    "stop": [
      {
        "command": "python3 \"${CURSOR_PLUGIN_ROOT}/hooks/unslop-hook.py\" check",
        "loop_limit": 1
      }
    ]
  }
}
